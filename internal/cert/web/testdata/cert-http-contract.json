    { "method": "POST",   "subpath": "/:id/key",                  "roles": ["RoleOpsEngineer"] },

    { "method": "GET",    "subpath": "/changes",                  "roles": ["RoleAuditor", "RoleOpsEngineer", "RoleOpsSupervisor"] },
    { "method": "POST",   "subpath": "/changes",                  "roles": ["RoleOpsEngineer"] },
    { "method": "GET",    "subpath": "/changes/:id",              "roles": ["RoleAuditor", "RoleOpsEngineer", "RoleOpsSupervisor"] },
    { "method": "POST",   "subpath": "/changes/:id/confirm",      "roles": ["RoleOpsEngineer"] },
    { "method": "POST",   "subpath": "/changes/:id/execute",      "roles": ["RoleOpsEngineer"] },
    { "method": "POST",   "subpath": "/changes/:id/confirm-batch","roles": ["RoleOpsEngineer"] },
    { "method": "POST",   "subpath": "/changes/:id/cancel",       "roles": ["RoleOpsEngineer"] },
    { "method": "GET",    "subpath": "/changes/:id/progress",     "roles": ["RoleOpsEngineer"] },
    { "method": "POST",   "subpath": "/changes/:id/rollback",     "roles": ["RoleOpsEngineer"] },
    { "method": "GET",    "subpath": "/changes/:id/audit",        "roles": ["RoleAuditor", "RoleOpsEngineer", "RoleOpsSupervisor"] },

    { "method": "GET",    "subpath": "/dashboard",                "roles": [] },
