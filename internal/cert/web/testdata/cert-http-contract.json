    { "method": "GET",    "subpath": "/discovery/preview",        "roles": ["RoleOpsEngineer"] },
    { "method": "GET",    "subpath": "/discovery/snapshot-status","roles": ["RoleOpsEngineer"] },
    { "method": "POST",   "subpath": "/discovery/import",         "roles": ["RoleOpsEngineer"] },
