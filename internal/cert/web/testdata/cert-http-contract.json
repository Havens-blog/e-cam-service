    { "method": "GET",    "subpath": "/:id/references",           "roles": ["RoleOpsEngineer"] },
    { "method": "POST",   "subpath": "/:id/scan",                 "roles": ["RoleOpsEngineer"] },

    { "method": "GET",    "subpath": "",                          "roles": ["RoleOpsEngineer", "RoleOpsSupervisor"] },
    { "method": "GET",    "subpath": "/stats",                    "roles": ["RoleOpsEngineer", "RoleOpsSupervisor"] },
    { "method": "GET",    "subpath": "/:id",                      "roles": ["RoleOpsEngineer", "RoleOpsSupervisor", "RoleViewer"] },
